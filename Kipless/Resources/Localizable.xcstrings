    "error.assertionCreation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not keep your Mac awake (IOKit error %ld)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保持 Mac 唤醒（IOKit 错误 %ld）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac を起動状態に保てませんでした（IOKit エラー %ld）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac을 깨어 있게 유지할 수 없습니다(IOKit 오류 %ld)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法保持 Mac 喚醒（IOKit 錯誤 %ld）。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac konnte nicht wach gehalten werden (IOKit-Fehler %ld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de garder le Mac éveillé (erreur IOKit %ld)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo mantener el Mac activo (error de IOKit %ld)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile mantenere il Mac attivo (errore IOKit %ld)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível manter o Mac acordado (erro do IOKit %ld)."
          }
        }
      }
    },
