{
  "sourceLanguage": "en",
  "strings": {
    "app.action.quit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Kipless"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 Kipless"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kipless を終了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kipless 종료"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束 Kipless"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kipless beenden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter Kipless"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir de Kipless"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci da Kipless"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerrar o Kipless"
          }
        }
      }
    },
    "app.action.quit.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Kipless and release the wake session"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 Kipless 并结束保持唤醒"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kipless を終了してセッションを解放します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kipless를 종료하고 세션을 해제합니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束 Kipless 並釋放保持喚醒"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kipless beenden und die Sitzung freigeben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter Kipless et libérer la session"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir de Kipless y liberar la sesión"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci da Kipless e rilascia la sessione"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerrar o Kipless e liberar a sessão"
          }
        }
      }
    },
