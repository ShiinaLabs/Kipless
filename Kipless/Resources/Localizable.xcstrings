    "permission.closedLid.approval.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In System Settings › General › Login Items, turn on Kipless in the background apps list to use Closed Lid mode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系统设置 › 通用 › 登录项」的“允许在后台”列表里打开 Kipless，即可使用合盖模式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定 › 一般 › ログイン項目」の“バックグラウンドで許可”で Kipless をオンにすると、クラムシェルモードを使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘시스템 설정 › 일반 › 로그인 항목’의 “배경에서 허용” 목록에서 Kipless를 켜면 덮개 닫기 모드를 사용할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系統設定 › 一般 › 登入項目」的「允許在背景」列表中開啟 Kipless，即可使用上蓋模式。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Kipless in „Systemeinstellungen › Allgemein › Anmeldeobjekte“ unter „Im Hintergrund erlauben“, um den Deckel-zu-Modus zu nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Kipless dans « Réglages Système › Général › Ouverture » sous « Autoriser en arrière-plan » pour utiliser le mode capot fermé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Kipless en «Ajustes del Sistema › General › Ítems de inicio», en «Permitir en segundo plano», para usar el modo tapa cerrada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Kipless in «Impostazioni di Sistema › Generali › Elementi login», alla voce «Consenti in background», per usare la modalità coperchio chiuso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Kipless em “Ajustes do Sistema › Geral › Itens de Início”, em “Permitir em Segundo Plano”, para usar o modo tampa fechada."
          }
        }
      }
    },
